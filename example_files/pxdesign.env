# PXDesign 运行配置。update 时保留本文件。
# 权重与数据目录
PXDESIGN_DATA=@PREFIX@/data
PXDESIGN_CHECKPOINT_DIR=@PREFIX@/data/release_data/checkpoint
TOOL_WEIGHTS_ROOT=@PREFIX@/data/tool_weights
PROTENIX_DATA_ROOT_DIR=@PREFIX@/data/protenix_data
CUDA_HOME=/usr/local/cuda-13.0
# GB10 上上游自定义 layernorm 内核编译不过，用 torch 实现
LAYERNORM_TYPE=torch
# 只用某块 GPU 时取消注释
# CUDA_VISIBLE_DEVICES=0
