# PXDesign 独立 prefix（钉死 Protenix@v0.5.0+pxd + torch 2.3.1 cu12）
PXDESIGN_PREFIX=/opt/protenix_build/prefix/pxdesign
SUPERVISOR_PREFIX=/opt/protenix_build/prefix/pxdesign
TOOL_WEIGHTS_ROOT=/opt/protenix_build/prefix/pxdesign/tool_weights
PROTENIX_DATA_ROOT_DIR=/opt/protenix_build/prefix/pxdesign/protenix_data
CUTLASS_PATH=/opt/protenix_build/prefix/pxdesign/cutlass
# CUDA_VISIBLE_DEVICES=0
PATH=/opt/protenix_build/prefix/pxdesign/venv/bin:/opt/protenix_build/prefix/pxdesign/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
