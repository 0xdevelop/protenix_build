# PXDesign 批作业单元（Type=oneshot）。
# 主进程 = Go pxdesignd：预检后运行 `pxdesign $PXDESIGN_JOB_ARGS`，退出码原样作为 unit 结果。
# 作业参数在 conf/pxdesign.env 的 PXDESIGN_JOB_ARGS 里写；失败不自动重启，由 StartLimit 兜底。
[Unit]
Description=PXDesign batch job (pxdesign via Go pxdesignd, oneshot)
After=local-fs.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/protenix_build/prefix/pxdesign
EnvironmentFile=/opt/protenix_build/prefix/pxdesign/conf/pxdesign.env
ExecStart=/opt/protenix_build/prefix/pxdesign/bin/pxdesignd $PXDESIGN_JOB_ARGS
TimeoutStartSec=infinity
Nice=5

[Install]
WantedBy=multi-user.target
