# PXDesign 环境冒烟单元（Type=oneshot，非常驻）。
# 主进程 = Go pxdesignd：定位 prefix 内 pxdesign CLI 并执行 `pxdesign --help` 预检后退出。
# 环境缺失（env 文件、venv、CLI 任一缺失或 --help 失败）→ 非零退出 → unit 进入 failed。
# 上游 pxdesign 没有常驻服务入口，因此不交付 Type=simple 常驻单元（未实现、未验收）。
[Unit]
Description=PXDesign smoke check (Go pxdesignd preflight, oneshot)
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/protenix_build/prefix/pxdesign
EnvironmentFile=/opt/protenix_build/prefix/pxdesign/conf/pxdesign.env
ExecStart=/opt/protenix_build/prefix/pxdesign/bin/pxdesignd
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
