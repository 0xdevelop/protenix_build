# Protenix 独立 prefix（最新 submodule / torch 2.7.1 cu12）
PROTENIX_PREFIX=/opt/protenix_build/prefix/protenix
SUPERVISOR_PREFIX=/opt/protenix_build/prefix/protenix
PROTENIX_ROOT_DIR=/opt/protenix_build/prefix/protenix/data
CUTLASS_PATH=/opt/protenix_build/prefix/protenix/cutlass
# CUDA_VISIBLE_DEVICES=0
PATH=/opt/protenix_build/prefix/protenix/venv/bin:/opt/protenix_build/prefix/protenix/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
