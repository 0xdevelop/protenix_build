# Protenix 运行配置。update 时保留本文件。
# 模型（唯一切换点）：protenix_base_default_v1.0.0 为公开权重（默认）；
# protenix-v2 需自备授权权重，放到 $PROTENIX_ROOT_DIR/checkpoint/protenix-v2.pt
PROTENIX_MODEL=protenix_base_default_v1.0.0
# 权重与 CCD 数据目录
PROTENIX_ROOT_DIR=@PREFIX@/data
CUDA_HOME=/usr/local/cuda-13.0
# GB10 上上游自定义 layernorm 内核编译不过，用 torch 实现
LAYERNORM_TYPE=torch
# 只用某块 GPU 时取消注释
# CUDA_VISIBLE_DEVICES=0
