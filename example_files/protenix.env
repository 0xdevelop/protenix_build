# Protenix 独立 prefix（最新 submodule；Python 3.14 + torch 2.14.1+cu130，见 constraints/py314-cu130.txt）
PROTENIX_PREFIX=/opt/protenix_build/prefix/protenix
SUPERVISOR_PREFIX=/opt/protenix_build/prefix/protenix
# 上游权重/CCD 缓存根目录（checkpoint/、common/ 在其下；首次运行从上游 TOS 自动下载）
PROTENIX_ROOT_DIR=/opt/protenix_build/prefix/protenix/data
# CUDA 13 工具链（torch/triton JIT 编译可能用到 nvcc）
CUDA_HOME=/usr/local/cuda-13.0
# torch cpp 扩展缓存放在 prefix 内，避免写到 root 家目录
TORCH_EXTENSIONS_DIR=/opt/protenix_build/prefix/protenix/torch_extensions
# CUDA_VISIBLE_DEVICES=0
PATH=/opt/protenix_build/prefix/protenix/venv/bin:/opt/protenix_build/prefix/protenix/bin:/usr/local/cuda-13.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 模型版本：单一切换点（传给 `protenix pred -n`，权重文件 = $PROTENIX_ROOT_DIR/checkpoint/<PROTENIX_MODEL>.pt，
# 缺失时上游自动从其 TOS 下载）。默认 v1；protenix-v2 有商业授权限制，确认授权前不要切换。
PROTENIX_MODEL=protenix_base_default_v1.0.0
# 上游已知自定义内核问题的回退（见 scripts/install_prefix_protenix.sh 说明）
LAYERNORM_TYPE=torch

# protenix-oneshot.service 的作业参数
PROTENIX_INPUT=/opt/protenix_build/prefix/protenix/jobs/input.json
PROTENIX_OUTPUT_DIR=/opt/protenix_build/prefix/protenix/jobs/output
PROTENIX_PRED_EXTRA_ARGS="--use_msa false -s 101"
