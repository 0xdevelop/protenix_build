[Unit]
Description=Protenix oneshot batch job (CLI run-to-completion)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/protenix_build/prefix/protenix
EnvironmentFile=-/opt/protenix_build/prefix/protenix/conf/protenix.env
# 生产替换为实际 pred 参数；默认 --help 冒烟
ExecStart=/opt/protenix_build/prefix/protenix/bin/protenix-run --help
Nice=5
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
