#!/bin/bash
# Protenix 命令入口：加载 conf/protenix.env 和当前版本的 venv，再执行上游 protenix。
#   protenix-run pred -i input.json -o out_dir [其它 protenix pred 参数]
# pred 未给 -n 时自动用配置里的 PROTENIX_MODEL。
# 上游 pred 在样本出错时仍返回 0、只写 <out_dir>/ERR/；这里检测到 ERR/ 就返回 3。
set -euo pipefail

PREFIX="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ENV_FILE="${PREFIX}/conf/protenix.env"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "${ENV_FILE}"
  set +a
fi
if [[ -x "${PREFIX}/current/venv/bin/protenix" ]]; then
  VENV="${PREFIX}/current/venv"
elif [[ -x "${PREFIX}/venv/bin/protenix" ]]; then
  VENV="${PREFIX}/venv"
else
  echo "[protenix-run] 找不到 protenix，请先执行 install_protenix.sh install" >&2
  exit 127
fi
export PROTENIX_ROOT_DIR="${PROTENIX_ROOT_DIR:-${PREFIX}/data}"
export LAYERNORM_TYPE="${LAYERNORM_TYPE:-torch}"
export CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.0}"
export VIRTUAL_ENV="${VENV}"
export PATH="${VENV}/bin:${CUDA_HOME}/bin:${PATH}"
MODEL="${PROTENIX_MODEL:-protenix_base_default_v1.0.0}"

if [[ "${1:-}" != "pred" ]]; then
  exec "${VENV}/bin/protenix" "$@"
fi

args=("$@")
out_dir="./output"
has_model=0
for ((i = 0; i < ${#args[@]}; i++)); do
  case "${args[i]}" in
    -o|--out_dir) out_dir="${args[i+1]:-${out_dir}}" ;;
    --out_dir=*) out_dir="${args[i]#--out_dir=}" ;;
    -n|--model_name) has_model=1; MODEL="${args[i+1]:-${MODEL}}" ;;
    --model_name=*) has_model=1; MODEL="${args[i]#--model_name=}" ;;
  esac
done
[[ ${has_model} -eq 1 ]] || args+=(-n "${MODEL}")

if [[ "${MODEL}" == protenix-v2* && ! -s "${PROTENIX_ROOT_DIR}/checkpoint/${MODEL}.pt" ]]; then
  echo "[protenix-run] ${MODEL} 需要授权权重：${PROTENIX_ROOT_DIR}/checkpoint/${MODEL}.pt 不存在" >&2
  exit 2
fi

rc=0
"${VENV}/bin/protenix" "${args[@]}" || rc=$?
if [[ ${rc} -eq 0 && -d "${out_dir}/ERR" && -n "$(ls -A "${out_dir}/ERR")" ]]; then
  echo "[protenix-run] 有样本失败，见 ${out_dir}/ERR/" >&2
  exit 3
fi
exit "${rc}"
